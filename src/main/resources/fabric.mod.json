{
  "schemaVersion": 1,
  "id": "create_aquatic_ambitions",
  "version": "${version}",
  "name": "Create Aquatic Ambitions",
  "description": "This is a Create Mod Add On that lets you automate prismarine without guardians farms, age your copper faster and revive dead coral. Made by DaviO. Forked by 冰焰",
  "authors": [
    "Made by DaviO",
    "Forked by 冰焰"
  ],
  "contact": {
    "homepage": "https://github.com/davioliva16/create-aquatic-ambitions",
    "sources": "https://github.com/tozyx/create-aquatic-ambitions"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.davio.create_aquatic_ambitions.CreateAquaticAmbitions"
    ],
    "client": [
      "net.davio.create_aquatic_ambitions.CreateAquaticAmbitionsClient"
    ],
    "jei_mod_plugin": [
      "net.davio.create_aquatic_ambitions.compat.jei.CCAJEI"
    ],
    "emi": [
      "net.davio.create_aquatic_ambitions.compat.EMI.CCAEmiPlugin"
    ]
  },
  "mixins": [
    "create_aquatic_ambitions.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": ">=${create_version}",
    "minecraft": "${minecraft_version}"
  }
}
